# ──────────────────────────────────────────────
# .gitignore único para o monorepo (backend + frontend)
# Regras sem barra inicial casam em qualquer nível.
# ──────────────────────────────────────────────

# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual env
.venv/
venv/
env/

# Env vars
.env

# Build / distribuição
build/
dist/
*.egg-info/

# Tests
.pytest_cache/
.coverage
htmlcov/

# Logs
*.log
npm-debug.log
yarn-error.log

# DB
*.sqlite3
*.db

# Node / Angular
node_modules/
.angular/
.sass-cache/
/coverage
testem.log

# Checkpoints e notebooks
.ipynb_checkpoints/
*.ipynb

# Arquivos PDF
*.pdf

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
